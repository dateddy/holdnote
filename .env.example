# Copy to .env.local and fill in. Never commit real keys.

# Supabase: Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only (scripts, AI routes). Never expose to the browser.
SUPABASE_SECRET_KEY=

# OpenRouter (server routes /api/review, /api/summary only)
OPENROUTER_API_KEY=
