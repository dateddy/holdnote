# Copy to .env.local and fill in. Never commit real keys.

# Supabase: Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only (scripts, AI routes). Never expose to the browser.
SUPABASE_SECRET_KEY=

# OpenRouter (server routes /api/review, /api/summary only)
OPENROUTER_API_KEY=
# Model for the free plan (any OpenRouter model id that supports JSON schema output).
OPENROUTER_MODEL=
# Hard monthly budget for what the app pays for AI, in USD. Free-plan AI locks when it is spent.
AI_FREE_BUDGET_USD=20
