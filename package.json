{
  "name": "holdnote",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint && prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked --schema public > apps/web/src/lib/supabase/database.types.ts && prettier --write apps/web/src/lib/supabase/database.types.ts",
    "test:rls": "pnpm --filter web test:rls",
    "bench:ai": "pnpm --filter web bench:ai"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0"
  }
}
